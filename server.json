{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Aelindra/zcode-session-mcp",
  "description": "Session CRUD, search, liveness, run & prompt injection for ZCode local sessions, plus the quota face: start-plan view, reset cards, claim plans, key switching. Zero-dependency.",
  "title": "ZCode Session MCP",
  "websiteUrl": "https://github.com/Aelindra/zcode-session-mcp",
  "repository": {
    "url": "https://github.com/Aelindra/zcode-session-mcp",
    "source": "github"
  },
  "version": "0.6.0",
  "authors": [
    {
      "name": "Aelindra"
    }
  ],
  "license": "MIT",
  "keywords": [
    "zcode",
    "zai",
    "glm",
    "session",
    "session-management",
    "agent",
    "coding-agent",
    "sqlite"
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "zcode-session-mcp",
      "version": "0.6.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ZCODE_SESSION_HOME",
          "description": "ZCode data home (defaults to ~/.zcode)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "ZCODE_SESSION_NODE",
          "description": "Node >= 22.5 executable for background job children (defaults to the server's own runtime)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
